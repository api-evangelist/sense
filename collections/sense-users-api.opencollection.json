{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sense Client Authentication Users API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get user usage timeline",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sense.com/apiservice/api/v1/users/:user_id/timeline",
            "params": [
              {
                "name": "user_id",
                "value": "654321",
                "type": "path",
                "description": "The user's Sense user ID"
              },
              {
                "name": "n_items",
                "value": "30",
                "type": "query",
                "description": "Number of timeline items to return"
              },
              {
                "name": "device_id",
                "value": "",
                "type": "query",
                "description": "Filter results to a specific device ID"
              },
              {
                "name": "prior_to_item",
                "value": "",
                "type": "query",
                "description": "Return items prior to this date/time (YYYY-MM-DDTHH:MM:SS.mmmZ)"
              },
              {
                "name": "rollup",
                "value": "",
                "type": "query",
                "description": "Optional rollup grouping parameter"
              }
            ]
          },
          "docs": "Retrieve a timeline of usage events and device activity for the authenticated user. Supports pagination and filtering by device."
        }
      ]
    }
  ],
  "bundled": true
}