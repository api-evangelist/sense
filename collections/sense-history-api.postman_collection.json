                "monitors",
                ":monitor_id",
                "history",
                "usage"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "scale",
                  "value": "<string>",
                  "description": "(Required) The time scale for aggregation"
                },
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<dateTime>",
                  "description": "(Required) Start date/time in ISO 8601 format (UTC)"
                }
              ],
              "variable": [
