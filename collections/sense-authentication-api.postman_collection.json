        {
          "id": "b8400aa2-5478-4a08-ba1e-e88594411785",
          "name": "Authenticate with email and password",
          "request": {
            "name": "Authenticate with email and password",
            "description": {
              "content": "Authenticate with a Sense account using email and password. Returns an access token, user ID, refresh token, and a list of associated monitors. If MFA is enabled, a 401 with an mfa_token is returned requiring a follow-up call to /authenticate/mfa.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "authenticate"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "email",
                  "value": "<email>",
                  "description": "(Required) The user's Sense account email address"
                },
                {
                  "disabled": false,
                  "key": "password",
                  "value": "<password>",
                  "description": "(Required) The user's Sense account password"
                }
              ]
            }
          },
          "response": [
