{
  "info": {
    "_postman_id": "7d098faf-8592-47d3-bb35-9640c00f102a",
    "name": "Sense Client Authentication API",
    "description": "The Sense Client REST API provides access to historical trend data and account information for Sense home energy monitors. Authenticated users can retrieve aggregated energy consumption and solar production statistics across configurable time scales including day, week, month, year, and billing cycle. The API returns device-level disaggregation data showing individual appliance consumption, grid exchange metrics, and monitor health information.\n\nContact Support:\n Name: Sense Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-10-22T01:37:18.000Z",
    "updatedAt": "2026-10-22T01:37:19.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-7d098faf-8592-47d3-bb35-9640c00f102a"
  },
