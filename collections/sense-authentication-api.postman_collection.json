          "item": [
            {
              "name": "Validate MFA code",
              "id": "692a2ec1-f22b-4d0d-a9d4-0553e4c35ba2",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/x-www-form-urlencoded"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "urlencoded",
                  "urlencoded": [
                    {
                      "description": "(Required) The 6-digit TOTP code from the authenticator app",
                      "key": "totp",
                      "value": "<string>"
                    },
                    {
                      "description": "(Required) The mfa_token returned from the initial authenticate call",
                      "key": "mfa_token",
                      "value": "<string>"
                    },
                    {
                      "description": "(Required) Current UTC time in ISO 8601 format",
                      "key": "client_time",
                      "value": "<dateTime>"
                    }
                  ]
                },
                "url": {
                  "raw": "{{baseUrl}}/authenticate/mfa",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "authenticate",
                    "mfa"
                  ]
                },
                "description": "Validate a Time-based One-Time Password (TOTP) code after initial authentication returned a 401 with an mfa_token. On success returns full auth credentials identical to the /authenticate response."
