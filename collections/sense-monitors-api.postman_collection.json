          "item": [
            {
              "name": "realtime_update",
              "item": [
                {
                  "name": "Get a single realtime update",
                  "id": "1e640996-beee-483e-8838-5cb77d624f0f",
                  "protocolProfileBehavior": {
                    "disableBodyPruning": true
                  },
                  "request": {
                    "method": "GET",
                    "header": [
                      {
                        "key": "Accept",
                        "value": "application/json"
                      }
                    ],
                    "url": {
                      "raw": "{{baseUrl}}/app/:monitor_id/realtime_update",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "app",
                        ":monitor_id",
                        "realtime_update"
                      ],
                      "variable": [
                        {
                          "id": "0e21dfd8-89a6-4566-b0d9-12f1097b3124",
                          "key": "monitor_id",
                          "value": "<string>",
                          "description": "(Required) The monitor's unique ID"
                        }
                      ]
                    },
                    "description": "Retrieve the current real-time power snapshot for a monitor without opening a WebSocket connection. Supported on monitors running firmware version 1.64 or later. Returns the same payload structure as the WebSocket realtime_update message."
                  },
                  "response": [
                    {
                      "id": "3ba9da13-41b1-447d-be56-f6f94beef286",
                      "name": "Realtime update snapshot",
                      "originalRequest": {
                        "method": "GET",
                        "header": [
                          {
                            "key": "Accept",
                            "value": "application/json"
                          },
                          {
                            "description": "Added as a part of security scheme: bearer",
                            "key": "Authorization",
                            "value": "Bearer <token>"
                          }
                        ],
                        "url": {
                          "raw": "{{baseUrl}}/app/:monitor_id/realtime_update",
                          "host": [
                            "{{baseUrl}}"
                          ],
                          "path": [
