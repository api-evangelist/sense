        {
          "id": "015194ee-9dc3-4a2c-80f1-c9fa910ac78c",
          "name": "Get a single realtime update",
          "request": {
            "name": "Get a single realtime update",
            "description": {
              "content": "Retrieve the current real-time power snapshot for a monitor without opening a WebSocket connection. Supported on monitors running firmware version 1.64 or later. Returns the same payload structure as the WebSocket realtime_update message.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "app",
                ":monitor_id",
                "realtime_update"
