                            ":monitor_id",
                            "realtime_update"
                          ],
                          "variable": [
                            {
                              "key": "monitor_id"
                            }
                          ]
                        }
                      },
                      "status": "OK",
                      "code": 200,
                      "_postman_previewlanguage": "json",
                      "header": [
                        {
                          "key": "Content-Type",
                          "value": "application/json"
                        }
                      ],
                      "cookie": [],
                      "responseTime": null,
                      "body": "{\n  \"w\": \"<float>\",\n  \"solar_w\": \"<float>\",\n  \"grid_w\": \"<float>\",\n  \"hz\": \"<float>\",\n  \"voltage\": [\n    \"<float>\",\n    \"<float>\"\n  ],\n  \"devices\": [\n    {\n      \"id\": \"<string>\",\n      \"name\": \"<string>\",\n      \"icon\": \"<string>\",\n      \"w\": \"<float>\"\n    },\n    {\n      \"id\": \"<string>\",\n      \"name\": \"<string>\",\n      \"icon\": \"<string>\",\n      \"w\": \"<float>\"\n    }\n  ]\n}",
